# Runtime-only secrets and local state (NOT committed to repo)
.runtime/
*.local
.env

# بيئةٌ معزولةٌ محليّةٌ — `tools/dev/bootstrap.sh` يُنشئُها في الجذرِ كما في
# دليلِ المشروع § 8، ودفعُها أو ظهورُها في `git status` يُلوِّثُ كلَّ فحصِ
# انحرافٍ يعتمدُ على نقاءِ الشجرة — وقد قيس (T0.2).
.venv/
venv/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# Test & coverage artifacts
.coverage
coverage.xml
coverage
*.db
amos_federation_test.db*
htmlcov/

# السجل الدستوري — يُولَّد وقت التشغيل، لا يُدفع (السلسلة تُحقَّق محليًا وفي CI)
core/constitution/ledger/*.jsonl
royal/crown/*.pem
royal/crown/*.key

# أقفال السجل الدستوري — أدواتُ تزامنٍ محليّةٌ لا أصلٌ هندسي
core/constitution/ledger/*.lock
*.jsonl.lock

# سجلُّ الأذونِ المُستهلَكة (1G) — حالةُ تشغيلٍ تُولَّد عند كلِّ إنفاذ، لا أصلٌ
# يُدفَع. موضعُه الافتراضيُّ داخلَ الشجرةِ المُتعقَّبة، فيُستثنى صراحةً لأنّ
# دفعَه كان يُلوِّثُ المستودعَ ويُسقِطُ فحصَ بطاقةِ الهويّة (المادة التاسعة).
royal/authority/CONSUMED_PERMITS.json
