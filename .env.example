# AMOS-Federation — قالبُ متغيّرات البيئة
# المالك: المالك المطلق للدولة (zoorooz)
# النطاق: قالبٌ يُنسَخ إلى `.env` (وهو مُستثنى في `.gitignore`) ثمّ تُملأ قيمُه.
# تاريخ آخر تعديل: 2026-08-18
#
# ## لِمَ لا توجد قيمٌ حقيقيّةٌ هنا
#
# كان هذا الملفُّ يحمل كلمةَ مرورِ PostgreSQL نافذةً نصًّا لمشروع Supabase قائم،
# ومفتاحَ `sb_publishable_...` معه، وهو ملفٌّ **مدفوعٌ إلى تاريخٍ عام**. وكونُه
# «قالبًا» لم يمنع أنّ كلَّ استنساخٍ للمستودع كان يُعيد نشرَ الاعتماد.
#
# وكان المدقّقُ الدستوريُّ أعمى عنه لسببين مقيسين: مسحُه محصورٌ في لواحقَ
# لا تشمل `.env.example`، ومحصورٌ كذلك في الأقاليم الاثني عشر فلا يبلغ جذرَ
# المستودع أصلًا. فأُغلقت البقعتان في `tools/governance/truth_audit.py`،
# فصار أيُّ اعتمادٍ نافذٍ في أيِّ ملفِّ بيئةٍ في أيِّ موضعٍ يُرفَع `HARDCODED_SECRET`.
#
# ## ما يبقى واجبًا على المالك — لا يُغلقه هذا التعديل
#
# نقلُ القيم إلى نائباتٍ يمنع الانتشارَ من الآن، ولا يمحو الاعتمادَ من تاريخ git.
# فتدويرُ كلمةِ مرورِ قاعدة البيانات ومفتاحِ Supabase **واجبٌ قائم**، وهو قرارُ
# مالكٍ وفعلُه — لا يُنفَّذ من داخل المستودع. انظر ACTIVE_EXECUTION_STATE.md.

# === Supabase PostgreSQL ===
# الاتّصالُ المُثبَتُ عملًا هو عبر المجمّع (pooler)، لا عبر المضيف المباشر:
# المضيفُ المباشر `db.<ref>.supabase.co` يُعلِن IPv6 فقط، فيسقط من بيئاتٍ بلا IPv6
# بـ`Network is unreachable`. أمّا المجمّعُ فيلزمه اسمُ مستخدمٍ مؤهَّلٌ بالمشروع
# على صورة `postgres.<project_ref>`، وإلّا رُفض بـ`Tenant or user not found`.
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_PROJECT_REF=<project_ref>
SUPABASE_PUBLISHABLE_KEY=<supabase_publishable_key>
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project_ref>

# === حزمةُ اختبارات PostgreSQL الحقيقيّة ===
# القيدُ المقيس (2026-08-18): وصولُ PostgreSQL من بيئةِ التطوير **يعمل** عبر
# المجمّع. والملاحظةُ التي كانت هنا سابقًا — أنّ الوصولَ محظورٌ وأنّ التحقّق
# مؤجَّل — صارت مخالفةً للواقع المقيس، فأُزيلت: ملاحظةُ عائقٍ زائلٍ تُنتج
# عائقًا وهميًّا دائمًا في الوثائق.
AMOS_RUN_POSTGRES_TESTS=0
AMOS_TEST_DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
AMOS_DB_SSLMODE=require
